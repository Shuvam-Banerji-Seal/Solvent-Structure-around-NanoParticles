# Complete C60 Solvation System Build with Validation and Visualization
# Using TIP4P/2005 water model for realistic solvation
# Optimized for multi-core CPU execution
# Usage: export OMP_NUM_THREADS=12 && lmp_mpi -in build_and_validate_C60.lmp

units metal
dimension       3
boundary        p p p
atom_style      full  # Changed to full for charges (TIP4P water)

# =====================================================================
# OpenMP PACKAGE for multi-threading on all cores
# =====================================================================
package         omp 0 neigh yes
# 0 = use OMP_NUM_THREADS environment variable
# neigh yes = threaded neighbor list construction

# Create simulation box manually to ensure topology space is allocated
# C60 box is -30 to 30
region          sim_box block -30 30 -30 30 -30 30
# Allocate space for 3 atom types, 2 bond types, 1 angle type
# And reserve space for bonds/special bonds per atom
create_box      3 sim_box bond/types 2 angle/types 1 extra/bond/per/atom 10 extra/angle/per/atom 10 extra/special/per/atom 100

# Define Masses
mass            1 12.011   # C (carbon in C60)
mass            2 15.999   # O (oxygen in water)
mass            3 1.008    # H (hydrogen in water)

# Read C60 data (append to existing box)
# Note: C60.data has 3 atom types, but we only use type 1 for C60.
read_data       ../data_files/C60.data add append

# Read TIP4P/2005 water molecule template
# offset: atomtypes bondtypes angletypes dihedraltypes impropertypes
molecule        h2omol ../data_files/H2O_TIP4P2005_fixed.mol offset 1 1 0 0 0

# Define styles
# Hybrid pair style: AIREBO for C60, TIP4P for Water, LJ for interactions
# AIREBO: 3.0 cutoff, 1 (LJ on), 1 (Torsion on)
# TIP4P: Otype=2, Htype=3, btype=2, atype=1, qdist=0.1546, cutoff=12.0
pair_style      hybrid airebo 3.0 1 1 lj/cut/tip4p/long/omp 2 3 2 1 0.1546 12.0
kspace_style    pppm/tip4p 1.0e-4

bond_style      harmonic
angle_style     harmonic

# Masses (already in data file, but ensuring consistency)
mass            1 12.011   # C (carbon in C60)
mass            2 15.999   # O (oxygen in water)
mass            3 1.008    # H (hydrogen in water)

# Pair Coefficients
# AIREBO for C-C (Type 1). Map Type 1->C, 2->NULL, 3->NULL
pair_coeff      * * airebo ../data_files/potentials/CH.airebo C NULL NULL

# LJ for Water and C-Water (TIP4P handles Coulombic automatically with kspace)
# C-O (Type 1-2): epsilon=0.05 eV (~1.15 kcal/mol?), sigma=3.2 A
# Note: AIREBO is in eV usually? No, units real means kcal/mol.
# AIREBO potential file usually has its own units. LAMMPS converts if standard.
# CH.airebo is usually in eV/Angstrom.
# Wait, "units real" uses kcal/mol. AIREBO in LAMMPS with "units real" expects input parameters in eV?
# Actually, the CH.airebo file provided with LAMMPS is in eV. LAMMPS handles conversion if units are metal/real?
# "The CH.airebo file ... parameters are in eV and Angstroms."
# "When using units real, you should use the CH.airebo file ... LAMMPS will convert..."
# So we are good.

# C-O Interaction (Lennard-Jones)
# epsilon ~ 0.1 kcal/mol, sigma ~ 3.4 A
pair_coeff      1 2 lj/cut/tip4p/long/omp 0.00434 3.35      # C-O (Optimized for C60-Water)
pair_coeff      1 3 lj/cut/tip4p/long/omp 0.0 0.0        # C-H (no interaction)

# Water-Water (TIP4P/2005)
pair_coeff      2 2 lj/cut/tip4p/long/omp 0.00803 3.1589 # O-O
pair_coeff      2 3 lj/cut/tip4p/long/omp 0.0 0.0       # O-H
pair_coeff      3 3 lj/cut/tip4p/long/omp 0.0 0.0       # H-H

# Bond parameters (Only for Water, C60 is handled by AIREBO)
bond_coeff      1 0.0 1.0         # Dummy bond type 1 (unused)
bond_coeff      2 20.0 0.9572     # O-H bonds in water (stiff for minimization)

# Angle parameters (Only for Water)
angle_coeff     1 2.5 104.52      # H-O-H angle in water (stiff for minimization)

# Group C60 atoms
group           c60_group type 1

# Create TIP4P water molecules in sphere (radius 18 Å to ensure coverage)
lattice         sc 3.2
region          water_sphere sphere 0 0 0 18 side in
create_atoms    0 region water_sphere mol h2omol 45678 units box

# Group water (O=type 2, H=type 3)
group           water_group type 2 3
group           water_O type 2
group           water_H type 3

# Smart deletion: remove water molecules with O within 3.5 Å of any C60 atom
# (AIREBO C-C bond is ~1.4, so 3.5 clearance is safe and avoids high energy overlaps)
delete_atoms    overlap 3.5 water_O c60_group mol yes

# Count atoms
variable        n_c60 equal count(c60_group)
variable        n_water equal count(water_group)
variable        n_total equal count(all)

print           "========================================"
print           "C60 Solvated System - Build Phase"
print           "========================================"
print           "C60 carbon atoms: ${n_c60}"
print           "Water oxygen atoms: ${n_water}"
print           "Total atoms: ${n_total}"

# Minimization to relax overlaps (SHAKE off during minimization)
print           "========================================"
print           "Minimizing System..."
print           "========================================"
minimize        1.0e-4 1.0e-6 5000 100000
reset_timestep  0

# Apply SHAKE constraints to water molecules (rigid O-H bonds and H-O-H angle)
fix             water_shake water_group shake 0.0001 20 0 b 2 a 1

# Gentle warm-up from 1K to 300K
thermo          100
thermo_style    custom step temp pe ke etotal press

velocity        all create 1.0 87287 loop geom
fix             gentle_warmup all nvt temp 1.0 300.0 0.5
run             5000
unfix           gentle_warmup

# Write initial system
write_data      C60_solvated.data pair ij
write_dump      all xyz C60_solvated_initial.xyz modify element C O H

print           "========================================"
print           "Starting MD Validation (100 ps NVT)"
print           "========================================"

# Initialize velocities
velocity        all create 300 12345 rot yes dist gaussian loop geom

# NVT dynamics for ALL atoms (C60 is free to move/vibrate)
fix             1 all nvt temp 300 300 0.5
timestep        0.001  # 1 fs

# Output for analysis
thermo          100
thermo_style    custom step temp pe ke etotal press vol density

# Compute properties
compute         rg_c60_compute c60_group gyration
compute         temp_c60 c60_group temp
compute         temp_water water_group temp

# Monitor C60 structure integrity
fix             rg_output all print 100 "$(step*dt/1000) $(c_rg_c60_compute)" file c60_rg.dat screen no title "# Time(ps) Rg(Angstrom)"
fix             temp_output all print 100 "$(step*dt/1000) $(c_temp_c60) $(c_temp_water)" file temperatures.dat screen no title "# Time(ps) T_C60(K) T_water(K)"

# Trajectory for visualization
dump            1 all xyz 100 C60_solvated_md.xyz
dump_modify     1 element C O H

# Run 10 ps
run             10000

# Final statistics
variable        rg_final equal gyration(c60_group)
variable        temp_final equal temp
variable        pe_final equal pe

print           "========================================"
print           "MD Validation Complete"
print           "========================================"
print           "Final temperature: ${temp_final} K"
print           "Final C60 Rg: ${rg_final} Angstroms"
print           "Final PE: ${pe_final} eV"
print           "C60 Structure: DYNAMIC (free to move)"

write_data      C60_solvated_after_md.data pair ij
write_dump      all xyz C60_solvated_final.xyz modify element C O H
